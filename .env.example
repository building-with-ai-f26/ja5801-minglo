# Run npm run db:local for an isolated local PostgreSQL database and .env.
# For another PostgreSQL server, copy this file to .env and edit DATABASE_URL.
DATABASE_URL="postgresql://minglo@127.0.0.1:55432/minglo?schema=public"
# Generate independently for each environment: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Only set for traffic exclusively through Heroku's router. Auto-detected on a dyno.
# Leave unset for local development; untrusted/missing addresses share a fallback quota.
# MINGLO_TRUST_PROXY="heroku"
