# Run npm run db:local for an isolated local PostgreSQL database and .env.
# For another PostgreSQL server, copy this file to .env and edit DATABASE_URL.
DATABASE_URL="postgresql://minglo@127.0.0.1:55432/minglo?schema=public"
# Generate independently for each environment: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Only set for traffic exclusively through Heroku's router. Auto-detected on a dyno.
# Leave unset for local development; untrusted/missing addresses share a fallback quota.
# MINGLO_TRUST_PROXY="heroku"
# Topics UI stays off until initial topics and moderation are reviewed for launch.
MINGLO_TOPICS_ENABLED=false
# Always off by default. Local/test capture uses only the loopback mock collector.
POSTHOG_ENABLED=false
POSTHOG_TRANSPORT=disabled
# POSTHOG_MOCK_HOST=http://127.0.0.1:3150
# Approved Heroku production only: cloud transport also requires NODE_ENV=production,
# DYNO, a valid AUTH_SECRET, the exact US ingestion host and environment label.
# POSTHOG_TRANSPORT=cloud
# POSTHOG_PROJECT_TOKEN=your-public-project-token
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_ENVIRONMENT=production

# Approved Build 2 verification only; never use on Heroku. Requires a loopback
# DATABASE_URL ending in _test, AUTH_URL=http://localhost:3000 and NODE_ENV=production.
# MINGLO_LOCAL_DEMO_ENABLED=true
# POSTHOG_TRANSPORT=cloud-local
# POSTHOG_ENVIRONMENT=verification
# Use the same exact US host/public project token above. Consent still required.

# Human sign-in/recovery rollout: disabled | trial | public. Disabled by default.
MINGLO_AUTH_ROLLOUT=disabled
# Trial checks the verified Google email or destination recovery email in the app.
# MINGLO_AUTH_TRIAL_EMAILS=first@example.com,second@example.com
# AUTH_GOOGLE_ID=your-google-web-client-id
# AUTH_GOOGLE_SECRET=install-securely
MINGLO_GOOGLE_SIGNUP_ENABLED=false
# Email delivery: disabled | resend | local. local requires loopback AUTH_URL,
# loopback disposable _test DB and no Heroku DYNO; writes only .local/auth-mail.
MINGLO_EMAIL_TRANSPORT=disabled
# RESEND_API_KEY=install-a-domain-restricted-sending-key-securely
# Enable the existing-human-account announcement only after public activation.
# MINGLO_AUTH_NOTICE_LAUNCHED_AT=2026-12-01T00:00:00Z

# Projects workspaces are enabled by default. Set false to pause v2 creation
# and workspace writes while keeping converted projects readable.
# MINGLO_PROJECTS_V2=false
