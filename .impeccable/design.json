      "css": ".ds-field{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:grid;gap:7px;color:var(--surface-ink,#172443);font-size:14px;font-weight:500}.ds-field input{font:400 16px/1.6 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;width:100%;min-height:46px;background:var(--surface-input,#fff);color:var(--surface-ink,#172443);border:1px solid var(--control-line,#7b879e);border-radius:7px;padding:12px 13px;outline:none;transition:border .15s,box-shadow .15s}.ds-field input::placeholder{color:var(--surface-muted,#52617b)}.ds-field input:focus{border-color:var(--action,#1637bc);outline:1px solid var(--action,#1637bc);outline-offset:1px}@media(prefers-reduced-motion:reduce){.ds-field input{transition:none}}"
