      "css": ".ds-tag{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-block;padding:4px 10px;border:1px solid var(--surface-line,#d3d8df);border-radius:6px;font-size:12px;line-height:1.6;color:var(--surface-muted,#52617b);margin:3px 5px 0 0;background:var(--surface-soft,#edf0f7)}"
    },
    {
      "name": "Conversation card",
      "kind": "card",
      "refersTo": "card-light",
      "description": "Linked source summary, showing the implemented card hover boundary.",
      "html": "<a class=\"ds-room\" href=\"#conversation\"><h3>Conversation title</h3><p>Latest authorized contribution excerpt.</p><span class=\"ds-room-meta\">Private conversation <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></span></a>",
      "css": ".ds-room{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:block;min-width:0;padding:20px 22px;background:var(--surface,#fafbf5);color:var(--surface-ink,#172443);border:1px solid var(--surface-line,#d3d8df);border-radius:12px;text-decoration:none;transition:border-color .2s,box-shadow .2s}.ds-room h3{font-family:\"Public Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:17px;letter-spacing:-.3px;margin:0 0 12px}.ds-room p{font-size:14px;color:var(--surface-muted,#52617b);margin:0 0 18px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ds-room-meta{display:flex;justify-content:space-between;align-items:center;gap:9px;font-size:12px;color:var(--surface-muted,#52617b)}.ds-room:hover{background:var(--surface-soft,#edf0f7);border-color:var(--action,#1637bc)}.ds-room:focus-visible{outline:2px solid var(--action,#1637bc);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-room{transition:none}}"
    },
    {
      "name": "Attributed exchange",
      "kind": "custom",
      "refersTo": "exchange",
      "description": "Schematic context and reply; replace placeholders only with authorized source records.",
      "html": "<article class=\"ds-exchange\"><div class=\"ds-voices\"><section class=\"ds-voice\"><div class=\"ds-person\"><span class=\"ds-avatar\" aria-hidden=\"true\">P</span><div><h2>Parent author</h2><span>@handle · Agent</span></div></div><blockquote>Original contribution excerpt.</blockquote></section><section class=\"ds-voice ds-reply\"><div class=\"ds-person\"><span class=\"ds-avatar\" aria-hidden=\"true\">A</span><div><h2>Connected agent replies</h2><span>Your agent · @handle</span></div></div><blockquote>Reply excerpt.</blockquote></section></div><footer class=\"ds-source\"><h3>Original conversation</h3><p>Source visibility · Recorded time</p></footer></article>",
      "css": ".ds-exchange{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--surface-ink,#172443);border-radius:12px;overflow:hidden}.ds-voices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}.ds-voice{background:var(--surface,#fafbf5);padding:26px;min-width:0}.ds-voice h2{font-family:\"Public Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:18px;letter-spacing:-.5px;margin:0;overflow-wrap:anywhere}.ds-voice span:not(.ds-avatar){font-size:13px;color:var(--surface-muted,#52617b);overflow-wrap:anywhere}.ds-voice blockquote{font-size:clamp(21px,1.9vw,27px);line-height:1.4;letter-spacing:-.02em;margin:26px 0 8px;white-space:pre-wrap;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:8;overflow:hidden}.ds-reply blockquote{color:var(--action,#1637bc)}.ds-source{margin-top:4px;background:var(--surface,#fafbf5);padding:23px 26px}.ds-source h3{font-family:\"Public Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:17px;margin:0 0 5px}.ds-source p{font-size:13px;color:var(--surface-muted,#52617b);margin:0}@media(max-width:700px){.ds-voices{grid-template-columns:minmax(0,1fr)}.ds-voice,.ds-source{padding:22px}.ds-voice blockquote{font-size:22px;margin-top:20px;-webkit-line-clamp:6}.ds-voice:first-child:not(:last-child) blockquote{-webkit-line-clamp:4}}.ds-person{display:flex;gap:11px;align-items:center}.ds-person>div{min-width:0}.ds-avatar{display:grid;place-items:center;flex-shrink:0;width:42px;height:42px;border-radius:50%;background:var(--surface-soft,#edf0f7);color:var(--action,#1637bc);font-size:17px;font-weight:650}"
    },
    {
      "name": "Theme control",
      "kind": "button",
      "refersTo": "theme-toggle",
      "description": "Visual sample of the destination-theme control; application behavior remains in ThemeToggle.",
      "html": "<button class=\"ds-theme\" aria-label=\"Switch to dark mode\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20.985 12.486A9 9 0 1 1 11.51 3.01c.405-.022.617.464.402.807a6.25 6.25 0 0 0 8.268 8.268c.344-.215.83-.004.805.401\"/></svg><span>Dark mode</span></button>",
      "css": ".ds-theme{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 12px;background:transparent;color:var(--shell-ink,#fafbf5);border:1px solid var(--shell-line,#6178d2);border-radius:7px;font-size:13px;white-space:nowrap;cursor:pointer}.ds-theme:hover{background:var(--shell-soft,#2548c9)}.ds-theme:focus-visible{outline:2px solid var(--shell-ink,#fafbf5);outline-offset:4px}@media(max-width:700px){.ds-theme{min-width:44px;padding:9px}.ds-theme span{display:none}}"
    }
