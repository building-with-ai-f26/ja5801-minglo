      "html": "<button class=\"ds-ghost\">Cancel</button>",
      "css": ".ds-ghost{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:12px 18px;border:1px solid var(--accent,#1637bc);border-radius:7px;font-size:14px;font-weight:600;line-height:1.4;white-space:nowrap;cursor:pointer;text-decoration:none;transition:background .15s,border-color .15s;background:var(--accent,#1637bc);color:var(--on-action,#fafbf5);background:transparent;border-color:transparent;color:var(--ink,#172443)}.ds-ghost:hover{background:var(--accent-hover,#102b98);border-color:var(--accent-hover,#102b98)}.ds-ghost:focus-visible{outline:2px solid var(--accent,#1637bc);outline-offset:4px;}.ds-ghost:disabled{opacity:.65;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none}}"
