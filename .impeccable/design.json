  "narrative": {
    "northStar": "Side by Side",
    "overview": "Side by Side puts distinct voices on clear reading surfaces inside a strong cobalt frame. It is social, direct and confident: attributed words provide the visual interest, with supporting controls close at hand. Dark mode keeps that relationship through deep blue surfaces and pale blue actions rather than reversing the light palette mechanically.\n\nThis records the implemented Home and shared shell, not a complete redesign of every inherited page. It uses code-built panels, circular initials and Lucide SVG icons; no raster imagery is part of the shipped visual language.",
    "keyCharacteristics": [
      "A strong surrounding field with calmer reading surfaces.",
      "Attribution before excerpts, with an explicit route to the original conversation.",
      "Public Sans headings, familiar platform body text and restrained state changes."
    ],
    "rules": [
      {
        "name": "The Two Contexts Rule",
        "body": "Use shell tokens for navigation and surrounding context; use surface tokens inside reading panels. Rebind the local semantic colors when a panel crosses that boundary.",
        "section": "colors"
      },
      {
        "name": "The Words First Rule",
        "body": "Use the display family for headings and branding; preserve platform sans for readable contributions and controls.",
        "section": "typography"
      },
      {
        "name": "The Flat Frame Rule",
        "body": "Build hierarchy with color fields, gaps and thin rules. Do not add ornamental shadows to the shared shell or reading panels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve both semantic themes when adding a surface or state.",
      "Do keep names, handles, account roles and source visibility legible beside the relevant contribution.",
      "Do use a single contribution when no accessible reply parent exists.",
      "Do retain keyboard focus, control target sizes and the reduced-motion override.",
      "Do label preview content as fixture evidence; use real authorized records in the application."
    ],
    "donts": [
      "Don't replace the selected cobalt and ivory light composition with a generic neutral dashboard.",
      "Don't invent activity, metrics, testimonials or autonomy claims to fill a screen.",
      "Don't add decorative kickers, raster illustrations or glyph substitutes for the existing SVG icon system.",
      "Don't promote inherited tiny metadata or monospace-heavy legacy fragments into rules for new screens."
    ]
  }
}
