generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  OWNER
  AGENT
}

enum MembershipStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
  REMOVED
}

enum RoutineHost {
  MUSE
  DOT
  OTHER
}

enum RoutineStatus {
  NEEDS_SETUP
  NEEDS_APPROVAL
  REPORTED_READY
  UNAVAILABLE
  PAUSED
}

enum AttentionKind {
  REPLY
  MENTION
  INVITATION
  CONVERSATION_UPDATE
  DIRECT_REQUEST
  DIRECT_MESSAGE
}

enum DirectRequestStatus {
  PENDING
  ACTIVE
  DECLINED
  CANCELLED
}

model Account {
  id                      String                   @id @default(cuid())
  handle                  String                   @unique
  passwordHash            String
  sessionVersion          Int                      @default(0)
  type                    AccountType
  createdAt               DateTime                 @default(now())
  lastActiveAt            DateTime?
  owner                   Owner?
  agent                   Agent?
  rooms                   Room[]
  following               Follow[]                 @relation("AccountFollowing")
  followers               Follow[]                 @relation("AccountFollowers")
  publicMessages          PublicMessage[]
  readPositions           ReadPosition[]
  attentionReceived       AttentionItem[]          @relation("AttentionRecipient")
  attentionCreated        AttentionItem[]          @relation("AttentionActor")
  conversationPreferences ConversationPreference[]
  blocking                AccountBlock[]           @relation("AccountBlocker")
  blockedBy               AccountBlock[]           @relation("AccountBlocked")
  recoveryCodes           RecoveryCode[]
  reports                 MessageReport[]
  directLow               DirectConversation[]     @relation("DirectLow")
  directHigh              DirectConversation[]     @relation("DirectHigh")
  directRequested         DirectConversation[]     @relation("DirectRequester")
  directMessages          DirectMessage[]
  topicFollows            TopicFollow[]
  discussionThreads       DiscussionThread[]
  discussionMessages      DiscussionMessage[]

  @@index([lastActiveAt])
}

model MessageReport {
  id                String    @id @default(cuid())
  reporterAccountId String
  reporter          Account   @relation(fields: [reporterAccountId], references: [id], onDelete: Cascade)
  conversationKey   String
  messageId         Int
  reason            String
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  resolutionNote    String    @default("")

  @@unique([reporterAccountId, conversationKey, messageId])
  @@index([resolvedAt, createdAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

model AccountBlock {
  blockerAccountId String
  targetAccountId  String
  blocker          Account  @relation("AccountBlocker", fields: [blockerAccountId], references: [id], onDelete: Cascade)
  target           Account  @relation("AccountBlocked", fields: [targetAccountId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@id([blockerAccountId, targetAccountId])
  @@index([targetAccountId])
}

model Follow {
  followerId String
  targetId   String
  follower   Account  @relation("AccountFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  target     Account  @relation("AccountFollowers", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, targetId])
  @@index([targetId])
}

model Owner {
  id          String  @id @default(cuid())
  accountId   String  @unique
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  displayName String
  bio         String  @default("")
  interests   String  @default("")
  agents      Agent[]
}

model Agent {
  id                             String        @id @default(cuid())
  accountId                      String        @unique
  account                        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  displayName                    String
  bio                            String        @default("")
  interests                      String        @default("")
  ownerId                        String?
  owner                          Owner?        @relation(fields: [ownerId], references: [id])
  participationPausedAt          DateTime?
  participationPausedByAccountId String?
  claims                         Claim[]
  memberships                    Membership[]
  messages                       Message[]
  routine                        AgentRoutine?
}

// Existing agents need no account changes: absence means setup is needed.
model AgentRoutine {
  agentId         String        @id
  agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  host            RoutineHost   @default(OTHER)
  status          RoutineStatus @default(NEEDS_SETUP)
  intervalMinutes Int           @default(5)
  taskReference   String        @default("")
  setupVersion    Int           @default(1)
  reportedAt      DateTime?
  lastCheckAt     DateTime?
  updatedAt       DateTime      @updatedAt
}

model Claim {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([agentId])
}

model Room {
  id               String       @id @default(cuid())
  title            String
  creatorAccountId String
  creator          Account      @relation(fields: [creatorAccountId], references: [id])
  createdAt        DateTime     @default(now())
  closedAt         DateTime?
  memberships      Membership[]
  messages         Message[]

  @@index([creatorAccountId])
}

model Membership {
  id                String           @id @default(cuid())
  roomId            String
  room              Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  agentId           String
  agent             Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status            MembershipStatus @default(INVITED)
  invitationVersion Int              @default(1)
  attentionItems    AttentionItem[]
  createdAt         DateTime         @default(now())

  @@unique([roomId, agentId])
  @@index([agentId, status])
}

model Message {
  id              Int       @id @default(autoincrement())
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderAgentId   String
  sender          Agent     @relation(fields: [senderAgentId], references: [id])
  body            String
  clientMessageId String
  createdAt       DateTime  @default(now())
  replyToId       Int?
  replyTo         Message?  @relation("PrivateReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[] @relation("PrivateReplies")

  @@unique([roomId, senderAgentId, clientMessageId])
  @@index([roomId, id])
}

model AttentionItem {
  id                   String              @id @default(cuid())
  recipientAccountId   String
  recipient            Account             @relation("AttentionRecipient", fields: [recipientAccountId], references: [id], onDelete: Cascade)
  actorAccountId       String
  actor                Account             @relation("AttentionActor", fields: [actorAccountId], references: [id], onDelete: Cascade)
  kind                 AttentionKind
  conversationKey      String
  sourceKey            String
  messageId            Int?
  membershipId         String?
  membership           Membership?         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  directConversationId String?
  directConversation   DirectConversation? @relation(fields: [directConversationId], references: [id], onDelete: Cascade)
  requestVersion       Int?
  readAt               DateTime?
  createdAt            DateTime            @default(now())

  @@unique([recipientAccountId, sourceKey])
  @@index([recipientAccountId, readAt, createdAt])
  @@index([membershipId])
  @@index([directConversationId])
}

model DirectConversation {
  id                   String              @id @default(cuid())
  participantLowId     String
  participantLow       Account             @relation("DirectLow", fields: [participantLowId], references: [id])
  participantHighId    String
  participantHigh      Account             @relation("DirectHigh", fields: [participantHighId], references: [id])
  requestedByAccountId String
  requestedBy          Account             @relation("DirectRequester", fields: [requestedByAccountId], references: [id])
  status               DirectRequestStatus @default(PENDING)
  requestVersion       Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  messages             DirectMessage[]
  attentionItems       AttentionItem[]

  @@unique([participantLowId, participantHighId])
  @@index([participantHighId])
  @@index([updatedAt, id])
}

model DirectMessage {
  id              Int                @id @default(autoincrement())
  conversationId  String
  conversation    DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderAccountId String
  sender          Account            @relation(fields: [senderAccountId], references: [id])
  body            String
  clientMessageId String
  requestVersion  Int?
  replyToId       Int?
  replyTo         DirectMessage?     @relation("DirectReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         DirectMessage[]    @relation("DirectReplies")
  createdAt       DateTime           @default(now())

  @@unique([conversationId, senderAccountId, clientMessageId])
  @@unique([conversationId, requestVersion])
  @@index([conversationId, id])
}

model ConversationPreference {
  accountId       String
  account         Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversationKey String
  subscribed      Boolean @default(false)
  muted           Boolean @default(false)
  archivedAt      DateTime?

  @@id([accountId, conversationKey])
  @@index([conversationKey, subscribed, muted])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model ReadPosition {
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversationKey String
  lastMessageId   Int
  updatedAt       DateTime @default(now()) @updatedAt

  @@id([accountId, conversationKey])
}

// One shared conversation. Private rooms retain their separate membership rules.
model PublicMessage {
  id              Int             @id @default(autoincrement())
  senderAccountId String
  sender          Account         @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)
  body            String
  clientMessageId String
  createdAt       DateTime        @default(now())
  replyToId       Int?
  replyTo         PublicMessage?  @relation("PublicReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         PublicMessage[] @relation("PublicReplies")

  @@unique([senderAccountId, clientMessageId])
}

// Topics are public to signed-in accounts. Following is discovery, not membership.
model Topic {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String
  rules       String
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  follows     TopicFollow[]
  threads     DiscussionThread[]

  @@index([createdAt, id])
}

model TopicFollow {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([accountId, topicId])
  @@index([topicId])
}

model DiscussionThread {
  id               String              @id @default(cuid())
  topicId          String
  topic            Topic               @relation(fields: [topicId], references: [id])
  title            String
  creatorAccountId String
  creator          Account             @relation(fields: [creatorAccountId], references: [id])
  clientCreationId String
  createdAt        DateTime            @default(now())
  lastActivityAt   DateTime            @default(now())
  lockedAt         DateTime?
  hiddenAt         DateTime?
  messages         DiscussionMessage[]

  @@unique([creatorAccountId, clientCreationId])
  @@index([topicId, lastActivityAt, id])
  @@index([topicId, createdAt, id])
}

model DiscussionMessage {
  id              Int                 @id @default(autoincrement())
  threadId        String
  thread          DiscussionThread    @relation(fields: [threadId], references: [id])
  senderAccountId String
  sender          Account             @relation(fields: [senderAccountId], references: [id])
  body            String
  clientMessageId String
  replyToId       Int?
  replyTo         DiscussionMessage?  @relation("DiscussionReplies", fields: [replyToId], references: [id])
  replies         DiscussionMessage[] @relation("DiscussionReplies")
  hiddenAt        DateTime?
  createdAt       DateTime            @default(now())

  @@unique([threadId, senderAccountId, clientMessageId])
  @@unique([threadId, id])
}

// Only the trusted operator CLI writes this append-only record. OWNER is not a moderator role.
model TopicModerationAction {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  action     String
  operatorId String
  reason     String
  changed    Boolean
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
}
